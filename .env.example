# ANVĪKṢA — Environment template (Phase 1 Schema Freeze)
# Copy to .env and adjust. No cloud dependencies.

# Postgres (docker-compose)
POSTGRES_DB=anviksa
POSTGRES_USER=anviksa
POSTGRES_PASSWORD=anviksa_dev

# Redis
REDIS_PASSWORD=anviksa_dev

# Backend
DATABASE_URL=postgresql+asyncpg://anviksa:anviksa_dev@localhost:5432/anviksa
REDIS_URL=redis://:anviksa_dev@localhost:6379/0
SECRET_KEY=dev-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
