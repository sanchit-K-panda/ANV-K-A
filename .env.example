# ANVĪKṢA — Environment template (TiDB Cloud)
# Copy to .env and adjust. No cloud dependencies for runtime.

# TiDB Cloud (MySQL-compatible)
DATABASE_URL=mysql+asyncmy://USER:PASS@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/test
DATABASE_SSL=true
REDIS_URL=redis://:anviksa_dev@localhost:6379/0
SECRET_KEY=dev-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
