[TEMPLATE]
# ANVĪKṢA — Environment template (100% local / air-gapped)
# Copy to .env and adjust. All services run locally via docker-compose.
# No cloud dependencies for runtime (Rules.md §4).

# Local PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://anviksa:anviksa_dev@localhost:5432/anviksa
DATABASE_SSL=false

# Local Redis (matches docker-compose.yml)
REDIS_URL=redis://:anviksa_dev@localhost:6379/0

# Local LLM (Ollama on localhost only — optional, deterministic fallback when offline)
ANVIKSA_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

SECRET_KEY=dev-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
